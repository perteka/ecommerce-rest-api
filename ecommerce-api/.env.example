# Postgres
# These values are injected at runtime; do not commit real credentials.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# JWT
# Generate a secure random secret (at least 32 characters) and keep it safe.
# In production, use a secrets manager or environment variable injection.
JWT_SECRET=placeholder-change-this-min-32-chars
JWT_ISSUER=ecommerce-api
JWT_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P7D
JWT_ABSOLUTE_REFRESH_EXPIRATION=P30D

# App
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
